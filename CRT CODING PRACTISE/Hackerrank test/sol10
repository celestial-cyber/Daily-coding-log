import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] arr = new int[n];

        for (int i = 0; i < n; i++)
            arr[i] = sc.nextInt();

        long shift = 0;

        for (int i = 0; i < n; i++) {
            int actualIndex = (int)((i - shift % n + n) % n);

            shift = (shift + arr[actualIndex]) % n;
        }

        int[] ans = new int[n];

        for (int i = 0; i < n; i++) {
            ans[(i + (int)shift) % n] = arr[i];
        }

        for (int x : ans)
            System.out.print(x + " ");
    }
}